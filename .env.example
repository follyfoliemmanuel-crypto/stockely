# =====================================================================
# Stockely — variables d'environnement (valeurs fictives uniquement)
# Copier ce fichier vers .env puis renseigner les vraies valeurs.
# Ne jamais committer .env.
# =====================================================================

# Base PostgreSQL. Sur Neon, utiliser la chaîne "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/stockely?sslmode=require"

# Secret applicatif : au moins 32 caractères aléatoires.
# Sert au hachage des adresses IP et à la signature d'éléments sensibles.
APP_SECRET="remplacer-par-une-chaine-aleatoire-de-64-caracteres"

# URL publique de l'application (sans slash final).
# En production (Vercel) : https://stockely.vercel.app
# En développement local : http://localhost:3000
APP_URL="https://stockely.vercel.app"

# Environnement : development | test | production
NODE_ENV="development"

# Base dédiée aux tests d'intégration. Ne jamais pointer vers la production.
# Créer une base dont le nom contient "test" (ex. stockely_test), appliquer
# les migrations avec `npm run db:migrate:test`, puis renseigner l'URL ici.
# Laisser vide pour désactiver les tests d'intégration.
TEST_DATABASE_URL=""

# Devise et fuseau par défaut à la création d'une boutique (surchargés par boutique).
DEFAULT_CURRENCY="XOF"
DEFAULT_TIMEZONE="Africa/Lome"

# Derrière un reverse proxy de confiance qui écrase X-Forwarded-For / X-Real-IP,
# passer cette valeur à "true" pour que la limitation de tentatives utilise
# l'adresse IP réelle. Ne jamais l'activer si l'application est exposée
# directement : un client pourrait alors forger ces en-têtes. Sur Vercel et
# Cloudflare, la plateforme est détectée automatiquement.
TRUST_PROXY="false"

# ---------------------------------------------------------------------
# Connexion Google (facultatif)
# Créer un identifiant OAuth 2.0 de type "Application Web" sur
# https://console.cloud.google.com/apis/credentials
# URI de redirection autorisé : ${APP_URL}/api/auth/google/callback
# Tant que ces valeurs sont vides, le bouton Google affiche un message
# explicite et la connexion par e-mail reste disponible.
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facultatif : forcer l'URI de redirection (sinon APP_URL + /api/auth/google/callback).
# Doit être déclarée à l'identique dans Google Cloud Console → Identifiants.
GOOGLE_REDIRECT_URI="https://stockely.vercel.app/api/auth/google/callback"

# ---------------------------------------------------------------------
# E-mails transactionnels via Resend (facultatif)
# Nécessaire pour « Mot de passe oublié ». Sans ces valeurs, l'API répond
# 503 email_not_configured — aucun e-mail n'est simulé.
# Le domaine de EMAIL_FROM doit être vérifié dans Resend.
# ---------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Stockely <no-reply@exemple.com>"

# ---------------------------------------------------------------------
# Assistant IA via IteraCompute (facultatif)
# API compatible OpenAI. La clé reste exclusivement côté serveur.
# Modèle gratuit par défaut : qwen/qwen3.8-27b.
# Sans clé, les routes /api/ai/* répondent 503 ai_not_configured.
# ---------------------------------------------------------------------
ITERACOMPUTE_API_KEY=""
ITERACOMPUTE_BASE_URL="https://api.iteracompute.com/v1"
ITERACOMPUTE_MODEL="qwen/qwen3.8-27b"
